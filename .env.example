# rsdeploy runs from the Atelier workspace root.
RSDEPLOY_DEST=
RSDEPLOY_FILTER=.rsdeploy-filter
RSDEPLOY_SRC=apps/docs/dist/

# Generated-site worktree used by the local publish routine.
ATELIER_DEPLOY_DIR=apps/docs/dist
ATELIER_DEPLOY_BRANCH=deploy
ATELIER_SITE_OUT_DIR=apps/docs/dist/public

# Shared site chrome and middleware source checkout.
PARENT_SITE_ROOT=
SITE_NAV_INCLUDE_ROOT=
