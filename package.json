{
	"name": "atelier",
	"version": "0.1.0",
	"private": true,
	"description": "Rémino's JavaScript libraries and their shared documentation site.",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build:packages && npm run build:docs",
		"build:packages": "npm run build --workspaces --if-present --workspace=dactylo --workspace=paradimg --workspace=remarqueeble --workspace=scrollerful --workspace=@remino/jukette-core --workspace=@remino/jukette-audio --workspace=@remino/jukette-midi --workspace=@remino/jukette-soundcloud --workspace=jukette",
		"build:docs": "npm run build --workspace=@remino/atelier-docs",
		"dev": "npm run dev --workspace=@remino/atelier-docs --",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present && vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-remark": "^7.2.2",
		"@eslint/js": "^10.0.1",
		"@remino/astro-image-variants": "^0.1.1",
		"@remino/astro-middleware": "^0.1.5",
		"@remino/astro-site-nav": "^0.4.2",
		"@remino/directive": "^5.5.3",
		"@remino/functions": "^1.3.2",
		"@types/node": "^26.2.0",
		"astro": "^7.1.6",
		"astro-compressor": "^1.3.0",
		"astro-eslint-parser": "^1.4.0",
		"astro-minify-html": "^0.1.1",
		"dompurify": "^3.4.13",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"globals": "^17.9.0",
		"jasmine": "^6.3.0",
		"lefthook": "^1.12.2",
		"lightningcss": "^1.33.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"shiki": "^4.4.2",
		"tsx": "^4.23.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0",
		"vitest": "^3.2.4"
	}
}
