{
	"name": "paradimg",
	"version": "0.1.1",
	"description": "Browser-side image URL modifiers and canvas effects.",
	"main": "./dist/paradimg.cjs",
	"module": "./dist/paradimg.mjs",
	"browser": "./dist/paradimg-auto.min.js",
	"unpkg": "./dist/paradimg-auto.min.js",
	"jsdelivr": "./dist/paradimg-auto.min.js",
	"exports": {
		".": {
			"import": "./dist/paradimg.mjs",
			"require": "./dist/paradimg.cjs"
		},
		"./auto": {
			"import": "./dist/paradimg-auto.mjs",
			"require": "./dist/paradimg-auto.cjs"
		}
	},
	"files": [
		"dist/*"
	],
	"homepage": "https://remino.net/paradimg/",
	"engines": {
		"node": ">=22.12.0"
	},
	"keywords": [
		"image",
		"canvas",
		"dither",
		"image-processing",
		"url-modifiers"
	],
	"author": {
		"name": "Rémino Rem",
		"url": "https://remino.net/"
	},
	"scripts": {
		"build": "npm run lib:build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lib:build": "node bin/build-js.mjs",
		"lint": "eslint --fix .",
		"lint:check": "eslint .",
		"precommit": "lint-staged",
		"prepare": "husky",
		"release": "release-it --config ../../.release-it.json",
		"release:dry-run": "release-it --config ../../.release-it.json --dry-run --verbose",
		"test": "NODE_OPTIONS=--import=tsx npx --no-install jasmine",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"sideEffects": [
		"./dist/paradimg-auto.*"
	],
	"license": "ISC",
	"type": "module",
	"lint-staged": {
		"*.{js,mjs,cjs}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,md,json}": "prettier --write"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.9.0",
		"husky": "^9.1.7",
		"jasmine": "^6.3.0",
		"lightningcss": "^1.33.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.6",
		"release-it": "^21.0.2",
		"tsx": "^4.23.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
