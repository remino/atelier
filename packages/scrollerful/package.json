{
	"author": {
		"name": "Rémino Rem",
		"url": "https://remino.net/"
	},
	"browser": "dist/scrollerful.cjs",
	"description": "Small JS & CSS library for scroll animations.",
	"devDependencies": {
		"autoprefixer": "^10.4.14",
		"cssnano": "^6.0.1",
		"cssnano-preset-default": "^6.0.1",
		"husky": "^9.1.7",
		"jasmine": "^4.5.0",
		"lint-staged": "^16.4.0",
		"npm": "^9.2.0",
		"postcss": "^8.4.25",
		"prettier": "^3.9.1",
		"release-it": "^20.2.1",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"vite": "^8.1.0"
	},
	"exports": {
		"import": "./dist/scrollerful.mjs",
		"require": "./dist/scrollerful.cjs"
	},
	"files": [
		"dist/*"
	],
	"homepage": "https://remino.net/scrollerful/",
	"keywords": [
		"javascript",
		"css",
		"animation",
		"scroll"
	],
	"license": "ISC",
	"main": "dist/scrollerful.cjs",
	"name": "scrollerful",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "npm run js:build",
		"js:build": "node bin/build-js.mjs",
		"lint": "eslint --fix .",
		"lint:check": "eslint .",
		"precommit": "lint-staged",
		"prepare": "husky",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"release": "release-it --config ../../.release-it.json",
		"release:dry-run": "release-it --config ../../.release-it.json --dry-run --verbose",
		"test": "NODE_OPTIONS=--import=tsx npx --no-install jasmine",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"lint-staged": {
		"*.{js,mjs,cjs,ts}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,md,json,yml,yaml}": "prettier --write"
	},
	"version": "1.2.2",
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"sharp@0.34.5": true
	}
}
