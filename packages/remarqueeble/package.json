{
	"author": {
		"name": "Rémino Rem",
		"url": "https://remino.net/"
	},
	"browser": "./dist/remarqueeble-auto.min.js",
	"description": "Custom element tribute to the cursed glory of marquee.",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jasmine": "^6.3.0",
		"lightningcss": "^1.32.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.7.4",
		"release-it": "^20.2.1",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.0"
	},
	"exports": {
		".": {
			"types": "./dist/remarqueeble.d.ts",
			"unpkg": "./dist/remarqueeble-auto.min.js",
			"import": "./dist/remarqueeble.mjs",
			"require": "./dist/remarqueeble.cjs"
		},
		"./auto": {
			"types": "./dist/auto.d.ts",
			"import": "./dist/remarqueeble-auto.mjs",
			"require": "./dist/remarqueeble-auto.cjs"
		},
		"./lite.css": "./dist/lite.css",
		"./lite.min.css": "./dist/lite.min.css"
	},
	"files": [
		"dist/*"
	],
	"homepage": "https://remino.net/remarqueeble/",
	"keywords": [
		"custom-element",
		"marquee",
		"web-components"
	],
	"license": "ISC",
	"main": "dist/remarqueeble.cjs",
	"module": "dist/remarqueeble.mjs",
	"name": "remarqueeble",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"unpkg": "./dist/remarqueeble-auto.min.js",
	"jsdelivr": "./dist/remarqueeble-auto.min.js",
	"sideEffects": [
		"./dist/remarqueeble-auto.*",
		"./dist/lite.css",
		"./dist/lite.min.css",
		"./src/lib/auto.ts"
	],
	"scripts": {
		"build": "npm run js:build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"js:build": "node bin/build-js.mjs && tsc --emitDeclarationOnly",
		"lib:build": "npm run js:build",
		"lint": "eslint --fix .",
		"lint:check": "eslint .",
		"precommit": "lint-staged",
		"prepare": "husky",
		"release": "release-it --config ../../.release-it.json",
		"release:dry-run": "release-it --config ../../.release-it.json --dry-run --verbose",
		"test": "NODE_OPTIONS=--import=tsx npx --no-install jasmine",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"types": "dist/remarqueeble.d.ts",
	"lint-staged": {
		"*.{js,mjs,cjs,ts}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,md,json,yml,yaml}": "prettier --write"
	},
	"version": "0.7.0"
}
