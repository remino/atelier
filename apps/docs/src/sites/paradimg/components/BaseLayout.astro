---
import SiteNavFooter from '@remino/astro-site-nav/SiteNavFooter.astro'
import SiteNavHeader from '@remino/astro-site-nav/SiteNavHeader.astro'
import SiteNavHtmlHead from '@remino/astro-site-nav/SiteNavHtmlHead.astro'
import LibraryBreadcrumbs from '../../../components/LibraryBreadcrumbs.astro'
import LibraryHeader from '../../../components/LibraryHeader.astro'
import '../assets/css/style.css'

const {
	title = 'Paradimg',
	description = 'Browser-side image URL modifiers.',
	path = '/paradimg/',
	bodyClass = '',
	mainClass = '',
	showHeader = true,
	breadcrumbs,
} = Astro.props
const siteUrl = Astro.site
	? new URL(path, Astro.site).toString()
	: 'https://remino.net/paradimg/'
const navItems = [
	{ label: 'Home', href: '/paradimg/' },
	{ label: 'Playground', href: '/paradimg/playground/' },
	{
		label: 'GitHub',
		href: 'https://github.com/remino/paradimg',
		external: true,
	},
	{
		label: 'npm',
		href: 'https://www.npmjs.com/package/paradimg',
		external: true,
	},
]
const breadcrumbItems =
	breadcrumbs ??
	(title === 'Paradimg'
		? [
				{ label: 'Atelier', href: '/atelier/' },
				{ label: 'Paradimg', href: '/paradimg/' },
			]
		: [
				{ label: 'Atelier', href: '/atelier/' },
				{ label: 'Paradimg', href: '/paradimg/' },
				{
					label: title.replace(/^Paradimg\s*/i, ''),
					href: path,
				},
			])
---

<!doctype html>
<html lang="en-CA" class="no-js rmn-nav-ribbon-bg-blur">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="viewport-fit=cover, width=device-width, initial-scale=1.0"
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<SiteNavHtmlHead />
		<script>
			document.documentElement.classList.replace('no-js', 'js')
		</script>
	</head>
	<body class={bodyClass}>
		<SiteNavHeader />
		{
			showHeader && (
				<LibraryHeader title="Paradimg" href="/paradimg/" items={navItems} />
			)
		}
		<main class={mainClass || undefined}><slot /></main>
		<LibraryBreadcrumbs items={breadcrumbItems} />
		<SiteNavFooter />
		<slot name="scripts" />
		<script>
			import '../assets/js/copy-buttons'
		</script>
	</body>
</html>
