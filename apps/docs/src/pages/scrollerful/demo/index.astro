---
import LibraryLayout from '../../../layouts/LibraryLayout.astro'
import Logo from '../../../sites/scrollerful/components/Logo.astro'
import { site } from '../../../sites/scrollerful/data/site.ts'
import '../../../sites/scrollerful/assets/css/site.css'
import '../../../sites/scrollerful/lib/scrollerful.css'
---

<LibraryLayout
	library="scrollerful"
	title={site.title}
	description={site.description}
	initializeScrollerful={false}
	pageUrl={`${site.url}demo/`}
	showHeader={false}
	wrapMain={false}
	scrollerfulCss
	bodyClass="demo--vertical demo--cover">
	<template class="controls-template js-template">
		<details class="controls">
			<summary>Demo Controls</summary>
			<form aria-label="Demo controls">
				<fieldset>
					<legend>Direction</legend>
					<label>
						<input type="radio" name="direction" value="vertical" checked />
						<span>Vertical</span>
					</label>
					<label>
						<input type="radio" name="direction" value="horizontal" />
						<span>Horizontal</span>
					</label>
				</fieldset>

				<fieldset>
					<legend>Container Size</legend>
					<label>
						<input type="radio" name="size" value="300" checked />
						<span>Large</span>
					</label>
					<label>
						<input type="radio" name="size" value="100" />
						<span>Medium</span>
					</label>
					<label>
						<input type="radio" name="size" value="50" />
						<span>Small</span>
					</label>
				</fieldset>

				<fieldset>
					<legend>Sprite Scope</legend>
					<label>
						<input type="radio" name="scope" value="cover" checked />
						<span>Cover</span>
					</label>
					<label>
						<input type="radio" name="scope" value="contain" />
						<span>Contain</span>
					</label>
				</fieldset>

				<nav>
					<a href="/scrollerful/">
						<span>Back to</span>
						<Logo />
					</a>
				</nav>
			</form>
		</details>
	</template>

	<section class="section--scroll-scroll sclf">
		<div class="sclf__float content">
			<div class="bg sclf__sprite">
				<p class="item--scroll-scroll sclf__sprite">Scroll!</p>
			</div>
		</div>
	</section>

	<section class="section--percentage sclf">
		<div class="sclf__float content">
			<div class="bg sclf__sprite"></div>
			<h1 class="item--percentage sclf__sprite">
				<output></output>%
			</h1>
		</div>
	</section>

	<section class="section--piechart sclf">
		<div class="sclf__float content">
			<div class="bg sclf__sprite"></div>
			<div class="item--piechart sclf__sprite"></div>
		</div>
	</section>

	<section class="section--video sclf">
		<div class="sclf__float content">
			<div class="bg sclf__sprite"></div>
			<video autoplay controls muted playsinline>
				<source src="/scrollerful/demo.mp4" type="video/mp4" />
			</video>
		</div>
	</section>
	<script src="../../../sites/scrollerful/assets/js/site.ts"></script>
</LibraryLayout>
