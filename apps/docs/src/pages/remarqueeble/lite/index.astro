---
import LibraryLayout from '../../../layouts/RemarqueebleLayout.astro'
import { site } from '../../../sites/remarqueeble/data/site'
import LiteContent from '../../../sites/remarqueeble/content/lite.md'
import '../../../sites/remarqueeble/lib/lite.css'
import '../../../sites/remarqueeble/assets/css/style.css'
---

<LibraryLayout
	library="remarqueeble"
	title="Lite"
	description={site.description}
	path="/remarqueeble/lite/"
	bodyClass="lite-page">
	<style is:global>
		.lite-lane {
			background: var(--dress-bg-2);
			border: var(--dress-bs) solid var(--dress-dt);
			box-sizing: border-box;
			margin-block: var(--dress-m-b);
			overflow: hidden;
			padding: var(--dress-p-b);
		}

		.lite-lane > .re-marquee {
			inline-size: 100%;
		}

		.lite-note {
			margin-block-start: 0;
		}
	</style>

	<LiteContent />
</LibraryLayout>
