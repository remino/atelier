---
import AtelierLayout from '../../layouts/AtelierLayout.astro'
import { getAtelierReadme } from '../../lib/atelier-readme'
import dactylo from '../../../../../packages/dactylo/package.json'
import jukette from '../../../../../packages/jukette/package.json'
import paradimg from '../../../../../packages/paradimg/package.json'
import remarqueeble from '../../../../../packages/remarqueeble/package.json'
import scrollerful from '../../../../../packages/scrollerful/package.json'

const readme = await getAtelierReadme()
const packages = [
	{ href: '/dactylo/', name: 'dactylo', ...dactylo },
	{ href: '/jukette/', name: 'jukette', ...jukette },
	{ href: '/paradimg/', name: 'paradimg', ...paradimg },
	{ href: '/remarqueeble/', name: 'remarqueeble', ...remarqueeble },
	{ href: '/scrollerful/', name: 'scrollerful', ...scrollerful },
]
---

<AtelierLayout>
	<article set:html={readme.beforePackages} />
	<nav class="readme-toc" aria-label="Contents">
		<ul>
			{
				readme.headings.map(heading => (
					<li class={`level-${heading.level}`}>
						<a href={heading.href}>{heading.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
	<section id="packages">
		<h2 id="packages">Packages</h2>
		<dl class="package-list">
			{
				packages.map(item => (
					<div>
						<dt>
							<a href={item.href}>
								<strong>{item.name}</strong>
							</a>
						</dt>
						<dd>{item.description}</dd>
					</div>
				))
			}
		</dl>
	</section>
	<article set:html={readme.afterPackages} />
</AtelierLayout>
