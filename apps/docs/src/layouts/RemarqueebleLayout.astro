---
import ProseLayout from './ProseLayout.astro'
import { site } from '../sites/remarqueeble/data/site'
import '../sites/remarqueeble/assets/css/style.css'

const navItems = [
	{ label: 'Home', href: '/remarqueeble/' },
	{ label: 'Playground', href: '/remarqueeble/playground/' },
	{ label: 'Lite', href: '/remarqueeble/lite/' },
	{ label: 'Updates', href: '/remarqueeble/updates/' },
	{ label: 'Licence', href: '/remarqueeble/license/' },
	{
		label: 'GitHub',
		href: 'https://github.com/remino/remarqueeble',
		external: true,
	},
	{
		label: 'npm',
		href: 'https://www.npmjs.com/package/remarqueeble',
		external: true,
	},
]
---

<script>
	import '../sites/remarqueeble/lib/auto'
</script>

<ProseLayout
	site={site}
	navItems={navItems}
	libraryPath="/remarqueeble/"
	{...Astro.props}>
	<slot />
	<slot name="scripts" slot="scripts" />
</ProseLayout>
