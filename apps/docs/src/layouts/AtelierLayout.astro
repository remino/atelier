---
import SiteNavFooter from '@remino/astro-site-nav/SiteNavFooter.astro'
import SiteNavHeader from '@remino/astro-site-nav/SiteNavHeader.astro'
import AtelierMenu from '../components/AtelierMenu.astro'
import BaseLayout from './BaseLayout.astro'
import '../assets/css/library.css'
import '../assets/css/atelier.css'

interface Props {
	title?: string
}

const { title = 'Atelier' } = Astro.props as Props
const site = {
	title: 'Atelier',
	readableTitle: 'Atelier',
	description: 'Collection of artsy components.',
	url: 'https://remino.net/atelier/',
}
---

<BaseLayout site={site} {title} description={site.description} path="/atelier/">
	<SiteNavHeader />
	<header>
		<h1><a href="/atelier/">Atelier</a></h1>
		<AtelierMenu />
	</header>
	<main><slot /></main>
	<SiteNavFooter><a href="/atelier/">Atelier</a></SiteNavFooter>
</BaseLayout>
