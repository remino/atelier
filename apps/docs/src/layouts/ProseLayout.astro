---
import SiteNavFooter from '@remino/astro-site-nav/SiteNavFooter.astro'
import SiteNavHeader from '@remino/astro-site-nav/SiteNavHeader.astro'
import AtelierNav from '../components/AtelierNav.astro'
import LibraryBreadcrumbs from '../components/LibraryBreadcrumbs.astro'
import LibraryHeader from '../components/LibraryHeader.astro'
import BaseLayout from './BaseLayout.astro'
import '../assets/css/library.css'

interface SiteData {
	title: string
	readableTitle: string
	description: string
	url: string
	image?: string
	imageAlt?: string
	twitterHandle?: string
}

interface NavItem {
	label: string
	href: string
	external?: boolean
}

interface Breadcrumb {
	label: string
	href?: string
}

interface Props {
	site: SiteData
	navItems: NavItem[]
	libraryPath: string
	title?: string
	description?: string
	path?: string
	pageUrl?: string
	bodyClass?: string
	mainClass?: string
	showHeader?: boolean
	showAtelierNav?: boolean
	breadcrumbs?: Breadcrumb[]
}

const {
	site,
	navItems,
	libraryPath,
	title = site.title,
	description = site.description,
	path = libraryPath,
	pageUrl,
	bodyClass = '',
	mainClass = '',
	showHeader = true,
	showAtelierNav = false,
	breadcrumbs,
} = Astro.props as Props
const breadcrumbItems = breadcrumbs ?? [
	{ label: 'Atelier', href: '/atelier/' },
	{ label: site.readableTitle, href: libraryPath },
	...(title === site.title ? [] : [{ label: title, href: path }]),
]
---

<BaseLayout {site} {title} {description} {path} {pageUrl} {bodyClass}>
	<SiteNavHeader />
	{
		showAtelierNav && (
			<header class="atelier-page-header">
				<AtelierNav />
			</header>
		)
	}
	{
		showHeader && (
			<LibraryHeader title={site.title} href={libraryPath} items={navItems} />
		)
	}
	<main class={mainClass || undefined}><slot /></main>
	<LibraryBreadcrumbs items={breadcrumbItems} />
	<SiteNavFooter><a href={libraryPath}>{site.readableTitle}</a></SiteNavFooter>
	<slot name="scripts" slot="scripts" />
</BaseLayout>
