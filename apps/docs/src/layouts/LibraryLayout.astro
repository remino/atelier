---
import SiteNavFooter from '@remino/astro-site-nav/SiteNavFooter.astro'
import SiteNavHeader from '@remino/astro-site-nav/SiteNavHeader.astro'
import SiteNavHtmlHead from '@remino/astro-site-nav/SiteNavHtmlHead.astro'
import AtelierNav from '../components/AtelierNav.astro'
import LibraryBreadcrumbs from '../components/LibraryBreadcrumbs.astro'
import LibraryHeader from '../components/LibraryHeader.astro'
import { site as dactylo } from '../sites/dactylo/data/site'
import { site as jukette } from '../sites/jukette/data/site'
import { site as remarqueeble } from '../sites/remarqueeble/data/site'
import { site as scrollerful } from '../sites/scrollerful/data/site'

interface SiteData {
	title: string
	readableTitle: string
	description: string
	url: string
	image?: string
	imageAlt?: string
	twitterHandle?: string
}

interface NavItem {
	label: string
	href: string
	external?: boolean
}

interface Breadcrumb {
	label: string
	href?: string
}

const configs = {
	dactylo: {
		site: dactylo,
		path: '/dactylo/',
		nav: [
			{ label: 'Home', href: '/dactylo/' },
			{ label: 'Demo', href: '/dactylo/demo/' },
			{ label: 'Updates', href: '/dactylo/updates/' },
			{ label: 'Licence', href: '/dactylo/license/' },
			{
				label: 'GitHub',
				href: 'https://github.com/remino/dactylo',
				external: true,
			},
			{
				label: 'npm',
				href: 'https://www.npmjs.com/package/dactylo',
				external: true,
			},
		],
	},
	jukette: {
		site: jukette,
		path: '/jukette/',
		nav: [
			{ label: 'Home', href: '/jukette/' },
			{ label: 'Playground', href: '/jukette/playground/' },
			{ label: 'Updates', href: '/jukette/updates/' },
			{ label: 'Licence', href: '/jukette/license/' },
			{
				label: 'GitHub',
				href: 'https://github.com/remino/jukette',
				external: true,
			},
			{
				label: 'npm',
				href: 'https://www.npmjs.com/package/jukette',
				external: true,
			},
		],
	},
	paradimg: {
		site: {
			title: 'Paradimg',
			readableTitle: 'Paradimg',
			description: 'Browser-side image URL modifiers.',
			url: 'https://remino.net/paradimg/',
		},
		path: '/paradimg/',
		nav: [
			{ label: 'Home', href: '/paradimg/' },
			{ label: 'Playground', href: '/paradimg/playground/' },
			{
				label: 'GitHub',
				href: 'https://github.com/remino/paradimg',
				external: true,
			},
			{
				label: 'npm',
				href: 'https://www.npmjs.com/package/paradimg',
				external: true,
			},
		],
	},
	remarqueeble: {
		site: remarqueeble,
		path: '/remarqueeble/',
		nav: [
			{ label: 'Home', href: '/remarqueeble/' },
			{ label: 'Playground', href: '/remarqueeble/playground/' },
			{ label: 'Lite', href: '/remarqueeble/lite/' },
			{ label: 'Updates', href: '/remarqueeble/updates/' },
			{ label: 'Licence', href: '/remarqueeble/license/' },
			{
				label: 'GitHub',
				href: 'https://github.com/remino/remarqueeble',
				external: true,
			},
			{
				label: 'npm',
				href: 'https://www.npmjs.com/package/remarqueeble',
				external: true,
			},
		],
	},
	scrollerful: {
		site: {
			...scrollerful,
			readableTitle: scrollerful.title,
			image: '/scrollerful/share.avif.jpg',
			imageAlt: 'Scrollerful share image',
		},
		path: '/scrollerful/',
		nav: [],
	},
} satisfies Record<string, { site: SiteData; path: string; nav: NavItem[] }>

interface Props {
	library: keyof typeof configs
	title?: string
	description?: string
	path?: string
	pageUrl?: string
	htmlClass?: string
	bodyClass?: string
	mainClass?: string
	showHeader?: boolean
	showAtelierNav?: boolean
	wrapMain?: boolean
	initializeScrollerful?: boolean
	scrollerfulCss?: boolean
	breadcrumbs?: Breadcrumb[]
}

const {
	library,
	title,
	description,
	path,
	pageUrl,
	htmlClass = '',
	bodyClass = '',
	mainClass = '',
	showHeader = true,
	showAtelierNav = false,
	wrapMain = true,
	initializeScrollerful = false,
	scrollerfulCss = false,
	breadcrumbs,
} = Astro.props as Props
const config = configs[library]
const site = config.site
const resolvedTitle = title ?? site.title
const resolvedDescription = description ?? site.description
const resolvedPath = path ?? config.path
const siteUrl =
	pageUrl ??
	(Astro.site ? new URL(resolvedPath, Astro.site).toString() : site.url)
const imageUrl =
	site.image &&
	(Astro.site ? new URL(site.image, Astro.site).toString() : site.image)
const documentTitle =
	resolvedTitle === site.title
		? resolvedTitle
		: `${resolvedTitle} // ${site.title}`
const readableDocumentTitle =
	resolvedTitle === site.title
		? site.readableTitle
		: `${resolvedTitle} // ${site.readableTitle}`
const breadcrumbItems = breadcrumbs ?? [
	{ label: 'Atelier', href: '/atelier/' },
	{ label: site.readableTitle, href: config.path },
	...(resolvedTitle === site.title
		? []
		: [{ label: resolvedTitle, href: resolvedPath }]),
]
const combinedHtmlClass = ['no-js', 'rmn-nav-ribbon-bg-blur', htmlClass]
	.filter(Boolean)
	.join(' ')
---

<!doctype html>
<html lang="en-CA" class={combinedHtmlClass}>
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="viewport-fit=cover, width=device-width, initial-scale=1.0"
		/>
		<meta name="format-detection" content="telephone=no" />
		<title>{readableDocumentTitle}</title>
		<meta name="description" content={resolvedDescription} />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={resolvedDescription} />
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		{site.imageAlt && <meta property="og:image:alt" content={site.imageAlt} />}
		<meta property="og:url" content={siteUrl} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={resolvedDescription} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}
		{
			site.twitterHandle && (
				<meta name="twitter:site" content={site.twitterHandle} />
			)
		}
		{
			site.twitterHandle && (
				<meta name="twitter:creator" content={site.twitterHandle} />
			)
		}
		<meta name="twitter:url" content={siteUrl} />
		{scrollerfulCss && <meta name="scrollerful-css" content="bundled" />}
		<SiteNavHtmlHead />
		<slot name="head" />
		<script>
			document.documentElement.classList.replace('no-js', 'js')
		</script>
	</head>
	<body class={bodyClass}>
		<SiteNavHeader />
		{
			showAtelierNav && (
				<header class="atelier-page-header">
					<AtelierNav />
				</header>
			)
		}
		{
			showHeader && (
				<LibraryHeader
					title={site.title}
					href={config.path}
					items={config.nav}
				/>
			)
		}
		{
			wrapMain ? (
				<main class={mainClass || undefined}>
					<slot />
				</main>
			) : (
				<slot />
			)
		}
		<LibraryBreadcrumbs items={breadcrumbItems} />
		<SiteNavFooter><a href={config.path}>{site.readableTitle}</a></SiteNavFooter
		>
		{
			initializeScrollerful && (
				<script src="../sites/scrollerful/assets/js/auto.ts" />
			)
		}
		<slot name="scripts" />
	</body>
</html>
