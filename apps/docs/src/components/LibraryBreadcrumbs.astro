---
interface Breadcrumb {
	label: string
	href?: string
}

interface Props {
	items: Breadcrumb[]
}

const { items } = Astro.props
---

<div class="rmn-nav__content">
	<ul class="rmn-breadcrumbs">
		{
			items.map(item => (
				<li>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>
			))
		}
	</ul>
</div>
